                  "const res = pm.response.json();",
                  "const list = Array.isArray(res.data) ? res.data : (res.data?.data || res.data?.restaurants || []);",
                  "if (list.length > 0) {",
                  "    const uuid = list[0].restaurant_uuid || list[0].uuid || list[0].id;",
                  "    if (uuid && !pm.collectionVariables.get('restaurantUuid')) {",
                  "        pm.collectionVariables.set('restaurantUuid', uuid);",
