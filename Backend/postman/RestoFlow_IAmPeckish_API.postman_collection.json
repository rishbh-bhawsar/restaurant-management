            },
            "url": {
              "raw": "{{baseUrl}}{{peckishBasePath}}/auth/authorize?URL_PARAMETER=URL_PATH={{peckishApiUrl}}:;:USERNAME={{username}}:;:PASSWORD={{password}}:;:CLIENT_ID={{clientId}}:;:CLIENT_SECRET={{clientSecret}}:;:ACCESS_TOKEN={{accessToken}}:;:RESTAURANT_UUID={{restaurantUuid}}",
              "host": ["{{baseUrl}}{{peckishBasePath}}"],
              "path": ["auth", "authorize"],
              "query": [
                {
                  "key": "URL_PARAMETER",
                  "value": "URL_PATH={{peckishApiUrl}}:;:USERNAME={{username}}:;:PASSWORD={{password}}:;:CLIENT_ID={{clientId}}:;:CLIENT_SECRET={{clientSecret}}:;:ACCESS_TOKEN={{accessToken}}:;:RESTAURANT_UUID={{restaurantUuid}}"
                }
