{
  "info": {
    "_postman_id": "a7f3c910-4b2e-4f19-9d5a-restoflow0001",
    "name": "RestoFlow - IAmPeckish API",
    "description": "Complete Postman collection for RestoFlow POS Backend & IAmPeckish Connect API integration with automatic MySQL (restoflow_pos) synchronization.\n\nQuick Start:\n1. Open Collection 'Variables' tab and fill in clientId, clientSecret, username, password, restaurantUuid.\n2. Run '1. Authentication -> Get Authorize URL' or open /api/peckish/auth/login in browser to obtain the authorization code.\n3. Paste the code into 'authCode' variable and run '1. Authentication -> Exchange Code for Token' (accessToken & refreshToken auto-save to collection variables).\n4. Run '2. Restaurants -> Get Restaurants' and any other data endpoint to fetch & persist into MySQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "peckishBasePath", "value": "/api/peckish", "type": "string" },
    { "key": "peckishApiUrl", "value": "https://api.iampeckish.com/connect/api/", "type": "string" },
    { "key": "username", "value": "", "type": "string" },
    { "key": "password", "value": "", "type": "string" },
    { "key": "clientId", "value": "", "type": "string" },
    { "key": "clientSecret", "value": "", "type": "string" },
    { "key": "redirectUri", "value": "http://localhost:5000/api/peckish/oauth/callback", "type": "string" },
    { "key": "authCode", "value": "", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "restaurantUuid", "value": "", "type": "string" },
    { "key": "supplierRef", "value": "", "type": "string" },
    { "key": "stocktakeUuid", "value": "", "type": "string" },
    { "key": "entityId", "value": "1", "type": "string" },
    { "key": "branchId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Core & Health",
      "item": [
        {
          "name": "API Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        },
        {
          "name": "Health Check (Server + MySQL)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Step 1A - Get Authorize URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{peckishBasePath}}/auth/authorize?client_id={{clientId}}&redirect_uri={{redirectUri}}",
              "host": ["{{baseUrl}}{{peckishBasePath}}"],
              "path": ["auth", "authorize"],
              "query": [
                { "key": "client_id", "value": "{{clientId}}" },
                { "key": "redirect_uri", "value": "{{redirectUri}}" },
                { "key": "redirect", "value": "false", "disabled": true }
              ]
            },
            "description": "Returns the IAmPeckish OAuth authorization URL. Open that URL in your browser to log in and capture the ?code=... parameter."
          }
        },
        {
          "name": "Step 1B - Browser OAuth Login (Redirect)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{peckishBasePath}}/auth/login?client_id={{clientId}}&redirect_uri={{redirectUri}}",
              "host": ["{{baseUrl}}{{peckishBasePath}}"],
              "path": ["auth", "login"],
              "query": [
                { "key": "client_id", "value": "{{clientId}}" },
                { "key": "redirect_uri", "value": "{{redirectUri}}" }
              ]
            }
          }
        },
        {
          "name": "Step 1C - OAuth Callback (Code Exchange)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const tokenData = res.tokens || res.data || res;",
                  "if (tokenData && tokenData.access_token) {",
                  "    pm.collectionVariables.set('accessToken', tokenData.access_token);",
                  "}",
                  "if (tokenData && tokenData.refresh_token) {",
                  "    pm.collectionVariables.set('refreshToken', tokenData.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}{{peckishBasePath}}/oauth/callback?code={{authCode}}&redirect_uri={{redirectUri}}",
              "host": ["{{baseUrl}}{{peckishBasePath}}"],
              "path": ["oauth", "callback"],
              "query": [
                { "key": "code", "value": "{{authCode}}" },
                { "key": "redirect_uri", "value": "{{redirectUri}}" }
              ]
            }
          }
        },
        {
          "name": "Step 2 - Exchange Code for Access & Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const tokenData = res.data || res;",
                  "if (tokenData && tokenData.access_token) {",
                  "    pm.collectionVariables.set('accessToken', tokenData.access_token);",
                  "    console.log('Saved accessToken to collection variables');",
                  "}",
                  "if (tokenData && tokenData.refresh_token) {",
                  "    pm.collectionVariables.set('refreshToken', tokenData.refresh_token);",
                  "    console.log('Saved refreshToken to collection variables');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"authorization_code\",\n  \"code\": \"{{authCode}}\",\n  \"client_id\": \"{{clientId}}\",\n  \"client_secret\": \"{{clientSecret}}\",\n  \"redirect_uri\": \"{{redirectUri}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{peckishBasePath}}/auth/token",
              "host": ["{{baseUrl}}{{peckishBasePath}}"],
              "path": ["auth", "token"]
            },
            "description": "Exchanges the authorization code for access_token and refresh_token, and automatically stores both in Postman collection variables."
          }
        },
        {
          "name": "Refresh Access Token (using refresh_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const tokenData = res.data || res;",
                  "if (tokenData && tokenData.access_token) {",
                  "    pm.collectionVariables.set('accessToken', tokenData.access_token);",
                  "}",
                  "if (tokenData && tokenData.refresh_token) {",
                  "    pm.collectionVariables.set('refreshToken', tokenData.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"refresh_token\",\n  \"refresh_token\": \"{{refreshToken}}\",\n  \"client_id\": \"{{clientId}}\",\n  \"client_secret\": \"{{clientSecret}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{peckishBasePath}}/auth/token",
              "host": ["{{baseUrl}}{{peckishBasePath}}"],
              "path": ["auth", "token"]
            }
          }
        },
        {
          "name": "Get Auth Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{peckishBasePath}}/auth/status",
              "host": ["{{baseUrl}}{{peckishBasePath}}"],
              "path": ["auth", "status"]
            }
          }
        },
        {
          "name": "Get Profile / Bearer Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{peckishBasePath}}/auth/me",
              "host": ["{{baseUrl}}{{peckishBasePath}}"],
              "path": ["auth", "me"]
            }
          }
