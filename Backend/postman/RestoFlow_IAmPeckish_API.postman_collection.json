        {
          "name": "Sign In (with URL_PARAMETER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{peckishBasePath}}/auth/signin?URL_PARAMETER=URL_PATH={{peckishApiUrl}}:;:USERNAME={{username}}:;:PASSWORD={{password}}:;:CLIENT_ID={{clientId}}:;:CLIENT_SECRET={{clientSecret}}:;:ACCESS_TOKEN={{accessToken}}:;:RESTAURANT_UUID={{restaurantUuid}}",
              "host": ["{{baseUrl}}{{peckishBasePath}}"],
              "path": ["auth", "signin"],
              "query": [
                {
                  "key": "URL_PARAMETER",
                  "value": "URL_PATH={{peckishApiUrl}}:;:USERNAME={{username}}:;:PASSWORD={{password}}:;:CLIENT_ID={{clientId}}:;:CLIENT_SECRET={{clientSecret}}:;:ACCESS_TOKEN={{accessToken}}:;:RESTAURANT_UUID={{restaurantUuid}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Test Token",
